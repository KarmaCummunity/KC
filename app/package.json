{
  "name": "karma-community",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "pnpm lint:arch && pnpm lint:i18n && turbo run lint",
    "lint:arch": "node scripts/check-architecture.mjs && node scripts/check-ssot-links.mjs && node ../scripts/spec-ids.mjs check",
    "lint:i18n": "node ../scripts/extract-hebrew-text.mjs --check",
    "lint:hebrew-register": "pnpm --filter @kc/mobile exec vitest run src/__tests__/copyVoiceRules.test.ts src/__tests__/copyVoiceGuard.test.ts",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "deps": "npx pnpm@9.15.9 install",
    "mobile": "npx pnpm@9.15.9 --filter @kc/mobile start",
    "mobile:go": "npx pnpm@9.15.9 --filter @kc/mobile run start:go",
    "mobile:go:tunnel": "npx pnpm@9.15.9 --filter @kc/mobile run start:go:tunnel",
    "ios": "npx pnpm@9.15.9 --filter @kc/mobile ios",
    "android": "npx pnpm@9.15.9 --filter @kc/mobile android",
    "build:web": "pnpm --filter @kc/mobile exec expo export -p web && node scripts/web-postbuild.mjs",
    "preview:web": "npx serve apps/mobile/dist --single",
    "check:migration-chain": "node ../scripts/check-migration-chain.mjs",
    "check:migration-safety": "node ../scripts/check-migration-safety.mjs",
    "check:rpc-contract": "node ../scripts/check-rpc-contract.mjs",
    "check:web-manifest": "node ../scripts/check-web-manifest.mjs",
    "check:backend-guards": "node ../scripts/check-migration-chain.mjs && node ../scripts/check-migration-safety.mjs && node ../scripts/check-rpc-contract.mjs",
    "test:scripts": "npm ci --prefix ../scripts --ignore-scripts --no-audit --no-fund && node --test ../scripts/*.test.mjs scripts/*.test.mjs",
    "test:e2e": "npm --prefix ../tests/e2e test",
    "test:e2e:ui": "npm --prefix ../tests/e2e run test:ui"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "turbo": "^2.11.10",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.72.1"
  },
  "pnpm": {
    "overrides": {
      "shell-quote": ">=1.11.0",
      "tar": ">=7.5.19",
      "brace-expansion@<2": "^1.1.19",
      "brace-expansion@>=2 <3": "^2.1.7",
      "brace-expansion@>=3": ">=5.0.11",
      "js-yaml": ">=4.3.0",
      "form-data@4": ">=4.0.6",
      "ws@6": ">=6.2.4",
      "ws@7": ">=7.5.11",
      "ws@8": ">=8.21.0",
      "hono@4": ">=4.13.14",
      "undici@6": "^6.28.1",
      "nanoid@3": "^3.3.18",
      "browserslist": "^4.28.7",
      "@xmldom/xmldom@0.8": "^0.8.15",
      "@xmldom/xmldom@0.9": "^0.9.12",
      "source-map-js": "^1.2.2",
      "compression": "^1.8.2",
      "decode-uri-component": ">=0.5.1",
      "vite@6": "^6.4.4",
      "postcss@>=8.5 <9": "^8.5.29",
      "zod@4": "^4.6.6",
      "metro@0.83": "0.83.8",
      "metro-babel-transformer@0.83": "0.83.8",
      "metro-cache-key@0.83": "0.83.8",
      "metro-cache@0.83": "0.83.8",
      "metro-config@0.83": "0.83.8",
      "metro-core@0.83": "0.83.8",
      "metro-file-map@0.83": "0.83.8",
      "metro-minify-terser@0.83": "0.83.8",
      "metro-resolver@0.83": "0.83.8",
      "metro-runtime@0.83": "0.83.8",
      "metro-source-map@0.83": "0.83.8",
      "metro-symbolicate@0.83": "0.83.8",
      "metro-transform-plugins@0.83": "0.83.8",
      "metro-transform-worker@0.83": "0.83.8",
      "markdown-it@10": "^14.3.3",
      "postcss@>=8.4 <8.5": "^8.5.29",
      "ajv@8": "^8.18.0",
      "@babel/core@7": "^7.29.6"
    }
  }
}
